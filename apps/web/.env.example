# Server-side URL of the Node API. The browser calls /api/*, which Next proxies here.
API_URL=http://localhost:4000
# Map tiles. Use a paid tile provider (MapTiler, Stadia, Mapbox) in production; OSM's servers are for light use only.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
