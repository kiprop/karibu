# Copy to apps/api/.env (or export) for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/karibu
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# 32+ random characters. Required in production.
COOKIE_SECRET=dev-only-change-me-dev-only-change-me
SESSION_DAYS=30
# Defaults to true in production. Set false only for plain-http local runs.
COOKIE_SECURE=
# Returns sign-in links and SMS codes in API responses. Never true in production.
EXPOSE_DEV_SECRETS=true
MIGRATE_ON_START=false
PG_POOL_MAX=10

# Email: console | resend
MAIL_PROVIDER=console
MAIL_FROM=Karibu <hello@karibu.example>
MAIL_API_KEY=

# SMS: console | africastalking
SMS_PROVIDER=console
SMS_USERNAME=
SMS_API_KEY=

# Google sign-in (optional): OAuth web client id
GOOGLE_CLIENT_ID=

# Vendor plans. While EARLY_ACCESS is not "false", paid plans activate without payment.
EARLY_ACCESS=true
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_FEATURED=

# Private vendor documents: local (S3/R2 driver to come)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
