# Copy to .env.production on the server and fill in. Never commit the real file.
PUBLIC_URL=https://karibu.enkopintelligence.com

# Database. Leave DATABASE_URL empty to use the database container in docker-compose.prod.yml.
# Supabase: Project Settings > Database > Connection string > "Session pooler" (works over IPv4), with your password filled in,
# and DATABASE_SSL=require.
DATABASE_URL=
DATABASE_SSL=off

# Long random values. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
COOKIE_SECRET=

# The email you will sign in with as the first admin.
ADMIN_EMAIL=

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel (the token after --token).
CLOUDFLARE_TUNNEL_TOKEN=

# Sign-in emails. Create a free Resend account, verify enkopintelligence.com (Resend gives you DNS records
# to add in Cloudflare), then paste the API key here. Without this, nobody can sign in.
MAIL_PROVIDER=resend
MAIL_FROM=EI Karibu <karibu@enkopintelligence.com>
MAIL_API_KEY=

# SMS sign-in codes (Africa's Talking). Leave as console until you have an account; phone sign-in won't work until then.
SMS_PROVIDER=console
SMS_USERNAME=
SMS_API_KEY=

# Optional
GOOGLE_CLIENT_ID=
EARLY_ACCESS=true
PAYSTACK_SECRET_KEY=

# Staff console. ADMIN_EMAIL is invited as the first Owner when the seed runs.
ADMIN_NAME=Mike Bitok
# Encrypts staff authenticator secrets. Generate with: openssl rand -hex 32 (optional; defaults to COOKIE_SECRET)
STAFF_SECRET_KEY=
